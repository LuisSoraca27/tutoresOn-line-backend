{
  "name": "@tutores-online/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:seed:demo": "node prisma/seed-demo.js",
    "db:studio": "prisma studio",
    "db:setup": "prisma generate && prisma migrate deploy && node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "pg": "^8.23.1",
    "ws": "^8.22.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  }
}
