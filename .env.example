# Valores locales de desarrollo. No uses estas credenciales en producción.
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://tutores:tutores_local@localhost:55432/tutores_online?schema=public
API_KEY_GEMINI=
