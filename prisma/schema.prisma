generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  student
  tutor

  @@map("user_role")
}

enum TutorModality {
  online
  in_person
  both

  @@map("tutor_modality")
}

enum SessionModality {
  online
  in_person

  @@map("session_modality")
}

enum BookingStatus {
  pending
  accepted
  rejected
  in_progress
  completed
  cancelled

  @@map("booking_status")
}

enum InstantRequestStatus {
  searching
  matched
  cancelled
  expired

  @@map("instant_request_status")
}

enum WithdrawalStatus {
  requested
  paid
  cancelled

  @@map("withdrawal_status")
}

enum NotificationChannel {
  email
  sms
  whatsapp

  @@map("notification_channel")
}

enum DeliveryStatus {
  simulated
  pending
  sent
  failed

  @@map("delivery_status")
}

enum NotificationEvent {
  booking_confirmed
  session_reminder
  status_changed
  session_summary

  @@map("notification_event")
}

enum NotificationType {
  new_booking
  booking_accepted
  booking_rejected
  booking_cancelled
  booking_rescheduled
  new_message
  session_completed
  new_review
  review_replied

  @@map("notification_type")
}

model City {
  id         String @id @db.VarChar
  name       String @db.VarChar
  department String @db.VarChar
  users      User[]

  @@map("cities")
}

model EducationLevel {
  id                 String                   @id @db.VarChar
  name               String                   @db.VarChar
  students           Student[]
  tutorSubjectLevels TutorSubjectLevel[]
  bookings           Booking[]
  instantRequests    InstantTutoringRequest[]

  @@map("education_levels")
}

model Subject {
  id              String                   @id @db.VarChar
  name            String                   @db.VarChar
  area            String                   @db.VarChar
  tutorSubjects   TutorSubject[]
  bookings        Booking[]
  instantRequests InstantTutoringRequest[]

  @@map("subjects")
}

model User {
  id                      String                   @id @db.VarChar
  name                    String                   @db.VarChar
  email                   String                   @unique @db.VarChar
  passwordHash            String                   @map("password_hash") @db.VarChar
  role                    UserRole
  phone                   String?                  @db.VarChar
  cityId                  String?                  @map("city_id") @db.VarChar
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  city                    City?                    @relation(fields: [cityId], references: [id])
  student                 Student?
  tutor                   Tutor?
  notes                   SessionNote[]
  messages                Message[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  passwordResets          PasswordReset[]
  authSessions            AuthSession[]

  @@map("users")
}

model Student {
  userId           String                   @id @map("user_id") @db.VarChar
  educationLevelId String                   @map("education_level_id") @db.VarChar
  user             User                     @relation(fields: [userId], references: [id])
  educationLevel   EducationLevel           @relation(fields: [educationLevelId], references: [id])
  bookings         Booking[]
  favorites        Favorite[]
  conversations    Conversation[]
  instantRequests  InstantTutoringRequest[]

  @@map("students")
}

model Tutor {
  userId             String                   @id @map("user_id") @db.VarChar
  professionalTitle  String                   @map("professional_title") @db.VarChar
  bio                String                   @db.Text
  avatarUrl          String?                  @map("avatar_url") @db.Text
  modality           TutorModality
  coverageRadiusKm   Decimal?                 @map("coverage_radius_km") @db.Decimal(6, 2)
  timezone           String                   @default("America/Bogota") @db.VarChar
  verified           Boolean                  @default(false)
  respondsQuickly    Boolean                  @default(false) @map("responds_quickly")
  availableNow       Boolean                  @default(false) @map("available_now")
  user               User                     @relation(fields: [userId], references: [id])
  subjects           TutorSubject[]
  languages          TutorLanguage[]
  schedulingRules    SchedulingRules?
  weeklyAvailability WeeklyAvailability[]
  exceptions         AvailabilityException[]
  bookings           Booking[]
  favorites          Favorite[]
  conversations      Conversation[]
  instantRequests    InstantTutoringRequest[]
  withdrawals        Withdrawal[]

  @@map("tutors")
}

model TutorSubject {
  tutorId    String              @map("tutor_id") @db.VarChar
  subjectId  String              @map("subject_id") @db.VarChar
  hourlyRate Decimal             @map("hourly_rate") @db.Decimal(12, 2)
  tutor      Tutor               @relation(fields: [tutorId], references: [userId])
  subject    Subject             @relation(fields: [subjectId], references: [id])
  levels     TutorSubjectLevel[]

  @@id([tutorId, subjectId])
  @@map("tutor_subjects")
}

model TutorSubjectLevel {
  tutorId          String         @map("tutor_id") @db.VarChar
  subjectId        String         @map("subject_id") @db.VarChar
  educationLevelId String         @map("education_level_id") @db.VarChar
  tutorSubject     TutorSubject   @relation(fields: [tutorId, subjectId], references: [tutorId, subjectId])
  educationLevel   EducationLevel @relation(fields: [educationLevelId], references: [id])

  @@id([tutorId, subjectId, educationLevelId])
  @@map("tutor_subject_levels")
}

model Language {
  id     String          @id @db.VarChar
  name   String          @unique @db.VarChar
  tutors TutorLanguage[]

  @@map("languages")
}

model TutorLanguage {
  tutorId    String   @map("tutor_id") @db.VarChar
  languageId String   @map("language_id") @db.VarChar
  tutor      Tutor    @relation(fields: [tutorId], references: [userId])
  language   Language @relation(fields: [languageId], references: [id])

  @@id([tutorId, languageId])
  @@map("tutor_languages")
}

model SchedulingRules {
  tutorId            String                   @id @map("tutor_id") @db.VarChar
  breakMinutes       Int                      @default(15) @map("break_minutes")
  minimumNoticeHours Int                      @default(12) @map("minimum_notice_hours")
  tutor              Tutor                    @relation(fields: [tutorId], references: [userId])
  durations          AllowedSessionDuration[]

  @@map("scheduling_rules")
}

model AllowedSessionDuration {
  tutorId         String          @map("tutor_id") @db.VarChar
  durationMinutes Int             @map("duration_minutes")
  rules           SchedulingRules @relation(fields: [tutorId], references: [tutorId])

  @@id([tutorId, durationMinutes])
  @@map("allowed_session_durations")
}

model WeeklyAvailability {
  id        String   @id @db.VarChar
  tutorId   String   @map("tutor_id") @db.VarChar
  dayOfWeek Int      @map("day_of_week") @db.SmallInt
  startTime DateTime @map("start_time") @db.Time(6)
  endTime   DateTime @map("end_time") @db.Time(6)
  tutor     Tutor    @relation(fields: [tutorId], references: [userId])

  @@index([tutorId, dayOfWeek])
  @@map("weekly_availability")
}

model AvailabilityException {
  tutorId String   @map("tutor_id") @db.VarChar
  date    DateTime @db.Date
  reason  String?  @db.Text
  tutor   Tutor    @relation(fields: [tutorId], references: [userId])

  @@id([tutorId, date])
  @@map("availability_exceptions")
}

model Booking {
  id               String                  @id @db.VarChar
  tutorId          String                  @map("tutor_id") @db.VarChar
  studentId        String                  @map("student_id") @db.VarChar
  subjectId        String                  @map("subject_id") @db.VarChar
  educationLevelId String                  @map("education_level_id") @db.VarChar
  modality         SessionModality
  startsAt         DateTime                @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime                @map("ends_at") @db.Timestamptz(6)
  durationMinutes  Int                     @map("duration_minutes")
  price            Decimal                 @db.Decimal(12, 2)
  status           BookingStatus           @default(pending)
  meetingLocation  String?                 @map("meeting_location") @db.Text
  studentNote      String?                 @map("student_note") @db.Text
  rejectionReason  String?                 @map("rejection_reason") @db.Text
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  tutor            Tutor                   @relation(fields: [tutorId], references: [userId])
  student          Student                 @relation(fields: [studentId], references: [userId])
  subject          Subject                 @relation(fields: [subjectId], references: [id])
  educationLevel   EducationLevel          @relation(fields: [educationLevelId], references: [id])
  report           SessionReport?
  notes            SessionNote[]
  review           Review?
  instantRequest   InstantTutoringRequest?

  @@index([tutorId, startsAt])
  @@index([studentId, startsAt])
  @@map("bookings")
}

model SessionReport {
  bookingId             String  @id @map("booking_id") @db.VarChar
  studentAttended       Boolean @map("student_attended")
  actualDurationMinutes Int     @map("actual_duration_minutes")
  observations          String? @db.Text
  booking               Booking @relation(fields: [bookingId], references: [id])

  @@map("session_reports")
}

model SessionNote {
  bookingId String  @map("booking_id") @db.VarChar
  userId    String  @map("user_id") @db.VarChar
  text      String  @db.Text
  booking   Booking @relation(fields: [bookingId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@id([bookingId, userId])
  @@map("session_notes")
}

model Review {
  id                     String    @id @db.VarChar
  bookingId              String    @unique @map("booking_id") @db.VarChar
  rating                 Int       @db.SmallInt
  comment                String    @db.Text
  punctualityRating      Int?      @map("punctuality_rating") @db.SmallInt
  clarityRating          Int?      @map("clarity_rating") @db.SmallInt
  subjectKnowledgeRating Int?      @map("subject_knowledge_rating") @db.SmallInt
  tutorReply             String?   @map("tutor_reply") @db.Text
  reportReason           String?   @map("report_reason") @db.Text
  reportedAt             DateTime? @map("reported_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  booking                Booking   @relation(fields: [bookingId], references: [id])

  @@map("reviews")
}

model Favorite {
  studentId String  @map("student_id") @db.VarChar
  tutorId   String  @map("tutor_id") @db.VarChar
  student   Student @relation(fields: [studentId], references: [userId])
  tutor     Tutor   @relation(fields: [tutorId], references: [userId])

  @@id([studentId, tutorId])
  @@map("favorites")
}

model Conversation {
  id             String    @id @db.VarChar
  studentId      String    @map("student_id") @db.VarChar
  tutorId        String    @map("tutor_id") @db.VarChar
  lastActivityAt DateTime  @map("last_activity_at") @db.Timestamptz(6)
  student        Student   @relation(fields: [studentId], references: [userId])
  tutor          Tutor     @relation(fields: [tutorId], references: [userId])
  messages       Message[]

  @@unique([studentId, tutorId])
  @@map("conversations")
}

model Message {
  id             String       @id @db.VarChar
  conversationId String       @map("conversation_id") @db.VarChar
  authorId       String       @map("author_id") @db.VarChar
  text           String       @db.Text
  sentAt         DateTime     @default(now()) @map("sent_at") @db.Timestamptz(6)
  isRead         Boolean      @default(false) @map("is_read")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  author         User         @relation(fields: [authorId], references: [id])

  @@index([conversationId, sentAt])
  @@map("messages")
}

model InstantTutoringRequest {
  id               String               @id @db.VarChar
  studentId        String               @map("student_id") @db.VarChar
  subjectId        String               @map("subject_id") @db.VarChar
  educationLevelId String               @map("education_level_id") @db.VarChar
  modality         SessionModality
  durationMinutes  Int                  @map("duration_minutes")
  note             String?              @db.Text
  status           InstantRequestStatus @default(searching)
  tutorId          String?              @map("tutor_id") @db.VarChar
  bookingId        String?              @unique @map("booking_id") @db.VarChar
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  student          Student              @relation(fields: [studentId], references: [userId])
  subject          Subject              @relation(fields: [subjectId], references: [id])
  educationLevel   EducationLevel       @relation(fields: [educationLevelId], references: [id])
  tutor            Tutor?               @relation(fields: [tutorId], references: [userId])
  booking          Booking?             @relation(fields: [bookingId], references: [id])

  @@map("instant_tutoring_requests")
}

model Withdrawal {
  id          String           @id @db.VarChar
  tutorId     String           @map("tutor_id") @db.VarChar
  amount      Decimal          @db.Decimal(12, 2)
  destination String           @db.Text
  status      WithdrawalStatus @default(requested)
  requestedAt DateTime         @default(now()) @map("requested_at") @db.Timestamptz(6)
  tutor       Tutor            @relation(fields: [tutorId], references: [userId])

  @@map("withdrawals")
}

model Notification {
  id          String                 @id @db.VarChar
  recipientId String                 @map("recipient_id") @db.VarChar
  type        NotificationType
  title       String                 @db.VarChar
  detail      String                 @db.Text
  link        String                 @db.Text
  isRead      Boolean                @default(false) @map("is_read")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  recipient   User                   @relation(fields: [recipientId], references: [id])
  deliveries  NotificationDelivery[]

  @@index([recipientId, isRead, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             BigInt              @id @default(autoincrement())
  notificationId String              @map("notification_id") @db.VarChar
  channel        NotificationChannel
  status         DeliveryStatus      @default(pending)
  detail         String?             @db.Text
  notification   Notification        @relation(fields: [notificationId], references: [id])

  @@map("notification_deliveries")
}

model NotificationPreference {
  userId  String              @map("user_id") @db.VarChar
  event   NotificationEvent
  channel NotificationChannel
  enabled Boolean             @default(true)
  user    User                @relation(fields: [userId], references: [id])

  @@id([userId, event, channel])
  @@map("notification_preferences")
}

model PasswordReset {
  id        BigInt    @id @default(autoincrement())
  userId    String    @map("user_id") @db.VarChar
  tokenHash String    @unique @map("token_hash") @db.VarChar
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@map("password_resets")
}

model AuthSession {
  tokenHash String   @id @map("token_hash") @db.VarChar
  userId    String   @map("user_id") @db.VarChar
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}
